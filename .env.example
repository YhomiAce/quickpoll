# Redis connection (database index 3 for local development)
REDIS_URL=redis://127.0.0.1:6379/3
# Secret used to sign the "already voted" cookies. Use 32+ random characters,
# e.g. `openssl rand -base64 32`.
COOKIE_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Public URL of the app. Required in production (form actions fail CSRF checks without it).
# ORIGIN=https://polls.example.com
# Optional: max votes per IP per minute (default 60)
# VOTE_RATE_LIMIT=60
